{
  "name": "mentecart-backend",
  "version": "1.0.0",
  "description": "MenteCart service booking backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "test:integration": "node --import tsx --test tests/**/*.test.ts",
    "verify": "npm run build && npm run test:integration"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "booking"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^11.1.0",
    "mongoose": "^9.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^5.8.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
